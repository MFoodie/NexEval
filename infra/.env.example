# Copy this file to infra/.env and replace every placeholder locally.
# Never commit infra/.env or real credentials.
MYSQL_ROOT_PASSWORD=replace-with-a-strong-local-password
DB_USERNAME=root
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=replace-with-your-smtp-app-password
DASHSCOPE_API_KEY=replace-with-your-dashscope-api-key
